# Copy this file to .env for local overrides, or set these in your Netlify
# site's Environment Variables dashboard for production.
#
# Locally, you can leave everything below unset: the app falls back to a
# SQLite file at data/groomcal.db and a dev JWT secret automatically.

# --- Database (Turso) ---
# Leave both unset for local dev (uses data/groomcal.db instead).
# Required in production (Netlify) - see README for how to create a free
# Turso database.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Auth ---
# A long random string used to sign login tokens. Required in production so
# logins survive deploys/restarts. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# --- Misc ---
# Set to "production" in Netlify (Netlify sets this automatically on deploy,
# you normally don't need to set it yourself). Leave unset locally.
NODE_ENV=
PORT=3000
